{
  "vcodec": "libx264",
  "vprofile": "main",
  "preset": "veryfast",
  "tune": "zerolatency",
  "deintfilter": "yadif=1",
  "defaultvbitratekb": 2048,
  "gop": 60,
  "keyintmin": 60,
  "scenechangethreshold": 0,
  "pixfmt": "yuv420p",
  "colorfmt": "bt709",
  "colorrange": "tv",
  "acodec": "aac",
  "defaultabitratekb": 384,
  "hlstime": 1,
  "hlslistsize": 30,
  "hlsflags": "independent_segments+delete_segments+program_date_time",
  "segmenttype": "mpegts"
}